<style>
  .sticky-atc {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #fff;
    border-top: 1px solid rgba(var(--color-foreground), 0.12);
    padding: 1.2rem calc(4rem / var(--font-body-scale));
    display: flex;
    align-items: center;
    gap: 1.2rem;
    transform: translateY(100%);
    transition: transform 0.28s cubic-bezier(.4,0,.2,1);
    box-shadow: 0 -4px 24px rgba(0,0,0,.08);
  }
  .sticky-atc.is-visible { transform: translateY(0); }
  .sticky-atc__thumb {
    width: 4.8rem;
    height: 4.8rem;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid rgba(var(--color-foreground), 0.08);
  }
  .sticky-atc__info { flex: 1; min-width: 0; }
  .sticky-atc__title {
    font-size: 1.3rem;
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sticky-atc__price { font-size: 1.3rem; color: rgba(var(--color-foreground), 0.75); }
  .sticky-atc__btn {
    flex-shrink: 0;
    padding: 1rem 2rem;
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
    border: none;
    font-size: 1.3rem;
    font-weight: 400;
    letter-spacing: .04em;
    border-radius: 0.8rem;
    cursor: pointer;
    white-space: nowrap;
  }
  .sticky-atc__btn:hover { opacity: .88; }
  /* 加购栏出现时（仅移动端）把第三方悬浮入口顶到栏上方，避免遮挡 */
  @media screen and (max-width: 989px) {
    body.sticky-atc-visible #ShopifyChat,
    body.sticky-atc-visible .loloyal-launcher-wrapper {
      bottom: 90px !important;
      transition: bottom 0.28s cubic-bezier(.4,0,.2,1);
    }
  }
  @media screen and (min-width: 990px) { .sticky-atc { display: none; } }
</style>

<div class="sticky-atc" id="StickyAtc-{{ product.id }}" aria-hidden="true">
  {%- if product.featured_media -%}
    {{
      product.featured_media
      | image_url: width: 120
      | image_tag: class: 'sticky-atc__thumb', loading: 'lazy', alt: product.title
    }}
  {%- endif -%}
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title }}</div>
    <div class="sticky-atc__price">
      {{- product.selected_or_first_available_variant.price | money -}}
    </div>
  </div>
  <button
    class="sticky-atc__btn"
    onclick="document.getElementById('ProductSubmitButton-{{ section.id }}')?.click()"
    aria-label="{{ 'products.product.add_to_cart' | t }}"
  >
    {{ 'products.product.add_to_cart' | t }}
  </button>
</div>

<script>
(function(){
  var bar = document.getElementById('StickyAtc-{{ product.id }}');
  if (!bar) return;
  var mainBtn = document.getElementById('ProductSubmitButton-{{ section.id }}');
  if (!mainBtn) return;

  // The bar is a way back to a buy button the reader has scrolled past, so it
  // follows the direction of travel: scrolling down (still browsing) hides it,
  // scrolling up (looking for something) brings it back. It never shows while
  // the real button is on screen — that test is read synchronously in the same
  // frame as the scroll, since an IntersectionObserver callback can land a
  // frame late and leave the bar up at the top of the page. It also stays away
  // from the first screenful, where the hero image is what the reader wants.
  var lastY = window.scrollY;
  var shown = false;
  var THRESHOLD = 8; // ignore the jitter of a finger resting on the screen
  var MIN_SCROLL = 300; // near the top the bar would just cover the hero image

  function setShown(next) {
    if (next === shown) return;
    shown = next;
    bar.classList.toggle('is-visible', next);
    bar.setAttribute('aria-hidden', String(!next));
    document.body.classList.toggle('sticky-atc-visible', next);
  }

  function buttonOnScreen() {
    var r = mainBtn.getBoundingClientRect();
    return r.bottom > 0 && r.top < window.innerHeight - 80;
  }

  var ticking = false;
  window.addEventListener(
    'scroll',
    function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        ticking = false;
        var y = window.scrollY;
        var delta = y - lastY;
        if (Math.abs(delta) < THRESHOLD) return;
        lastY = y;
        setShown(y > MIN_SCROLL && !buttonOnScreen() && delta < 0);
      });
    },
    { passive: true }
  );
})();
</script>
