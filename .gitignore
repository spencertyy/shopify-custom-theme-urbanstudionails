# Shopify CLI
.shopify/

# Local IDE / tool config
.claude/
.DS_Store
*.log

# Live store data — contains real store config, social links, product refs
# Use config/settings_data.example.json as reference instead
config/settings_data.json

# Private notes / internal docs — ignore ALL markdown except README.md
*.md
!README.md

# Private exports & tooling artifacts
*.docx
.playwright-mcp/

# Legal policy source docs — the live versions are on the store; these stay
# local so the public repo never carries a stale copy of the terms
*_FINAL.html
*_FINAL.txt

# Spreadsheets and other working docs
*.xlsx
