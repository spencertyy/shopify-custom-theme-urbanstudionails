{%- comment -%}
  FAQ section — renders a visible accordion (native <details>, no JS) and
  outputs matching FAQPage JSON-LD so Google / AI can read the Q&A.
  Content is editable per-block in the theme editor.

  Two block types:
    question — one Q&A pair; included in the JSON-LD
    category — a section divider heading; visual only, skipped in the JSON-LD

  Keep every Q&A on this one section: Google expects a single FAQPage entity
  per page, so splitting across several sections would emit competing blocks
  of structured data.

  The JSON-LD is opt-out per section (enable_schema). Turn it OFF anywhere the
  page already has a primary entity of its own — product pages emit Product
  schema, and a second FAQPage there both competes with it and repeats the same
  Q&A across every product URL.
{%- endcomment -%}

{%- liquid
  assign faq_blocks = section.blocks
-%}

{% style %}
  .faq-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .faq-{{ section.id }} .faq__list {
    /* matches Dawn's .page-width--narrow so the list lines up with the page H1 */
    max-width: 72.6rem;
    margin: 0 auto;
  }
  .faq-{{ section.id }} .faq__heading {
    text-align: center;
    margin: 0 0 3rem;
  }
  .faq-{{ section.id }} .faq__item {
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12);
  }
  .faq-{{ section.id }} .faq__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.6rem;
    padding: 1.8rem 0;
    font-size: 1.7rem;
    /* Jost ships 400 / 500 / 700 only — a 600 here resolves upward to 700 and
       reads as heavy as a heading. Body weight keeps the questions calm. */
    font-weight: var(--font-body-weight);
    line-height: 1.4;
  }
  .faq-{{ section.id }} .faq__item summary::-webkit-details-marker { display: none; }
  .faq-{{ section.id }} .faq__icon {
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.2s ease;
  }
  .faq-{{ section.id }} .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq-{{ section.id }} .faq__answer { padding: 0 0 1.8rem; }
  .faq-{{ section.id }} .faq__answer > :first-child { margin-top: 0; }
  .faq-{{ section.id }} .faq__answer > :last-child { margin-bottom: 0; }
  .faq-{{ section.id }} .faq__category {
    margin: 4rem 0 0;
    padding-bottom: 1.6rem;
    font-size: 2rem;
    font-weight: 400;
    letter-spacing: -0.04rem;
    line-height: 1.2;
    text-transform: none;
    border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.35);
  }
  @media screen and (min-width: 750px) {
    .faq-{{ section.id }} .faq__category {
      margin-top: 5.6rem;
      font-size: 2.4rem;
    }
  }
  .faq-{{ section.id }} .faq__category:first-child { margin-top: 0; }
  .faq-{{ section.id }} .faq__footer {
    margin: 2.4rem 0 0;
    font-size: 1.4rem;
  }
{% endstyle %}

<div class="faq-{{ section.id }} section{% if section.settings.color_scheme != blank %} color-{{ section.settings.color_scheme }} gradient{% endif %} isolate">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="faq__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="faq__list">
      {%- for block in faq_blocks -%}
        {%- if block.type == 'category' -%}
          <h3 class="faq__category" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</h3>
        {%- else -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.question | escape }}</span>
              <svg class="faq__icon" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.footer_link_label != blank and section.settings.footer_link_url != blank -%}
        <p class="faq__footer">
          <a href="{{ section.settings.footer_link_url }}" class="link">
            {{- section.settings.footer_link_label | escape -}}
          </a>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{%- liquid
  assign question_blocks = faq_blocks | where: 'type', 'question'
-%}
{%- if section.settings.enable_schema and question_blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in question_blocks -%}
    {%- liquid
      assign answer_text = block.settings.answer | replace: '</p>', '</p> ' | replace: '</li>', '</li> ' | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | strip_html | strip_newlines | strip
    -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ answer_text | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Link to the full FAQ"
    },
    {
      "type": "text",
      "id": "footer_link_label",
      "label": "Link text",
      "info": "Shown below the last question. Leave blank to hide."
    },
    {
      "type": "url",
      "id": "footer_link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Search engines"
    },
    {
      "type": "checkbox",
      "id": "enable_schema",
      "label": "Output FAQ structured data",
      "default": true,
      "info": "Leave on for the dedicated FAQ page. Turn off on product pages — they already output Product structured data, and repeating the same FAQPage on every product URL adds no benefit."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Category"
        },
        {
          "type": "paragraph",
          "content": "A visual divider only. Category headings are not included in the page's FAQ structured data."
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long will they last?",
            "answer": "<p>With sticky tabs, expect up to 5 days. With glue, 1–2 weeks, and often longer with careful wear. Hot showers, gym sessions and washing up without gloves are all quietly working against you.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I apply press-on nails?",
            "answer": "<p>Prep your natural nails, pick the sizes that fit best, then press on. The whole process takes under 5 minutes, and full steps are included in every set.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are the nails reusable?",
            "answer": "<p>Yes. Gently remove them, clean off any residue, and store them in the box. Each set can be worn multiple times when applied with adhesive tabs.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What is included in each set?",
            "answer": "<p>Every set includes 10 handmade press-on nails, a nail file, adhesive nail tabs, nail glue, a wooden cuticle pusher, and alcohol wipes.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What if the size is wrong when it arrives?",
            "answer": "<p>Because every set is handmade and worn directly on the body, we're not able to accept returns or exchanges for sizing — the same rule that applies to most personal care and beauty products. Every product page has a Size Chart, and if you're unsure, message us before you order. We genuinely don't mind.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I remove them safely?",
            "answer": "<p>Soak your nails in warm soapy water for a few minutes to loosen the adhesive, then gently lift each nail from the side. Never force them off.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Are these nails handmade?",
            "answer": "<p>Yes — every set is 100% handcrafted. Small variations between pieces are normal and part of the handmade charm.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
