{%- comment -%}
  Instagram centre-gallery: two loose image columns either side of a
  large @handle sitting in a clear middle column — a symmetric grid
  with offset columns, not a scattered collage.

  The images are NOT uploaded by hand. The Instafeed app block (which
  must remain somewhere on the same page) fetches the latest posts and
  writes each thumbnail URL into a data-instafeed-thumbnail attribute.
  After load, this section harvests the first few thumbnails from that
  DOM, fills its slots, then hides the app's own rendering. If the app
  ever fails or changes markup, the harvest finds nothing, this section
  stays hidden, and the app's stock feed remains visible — the page
  degrades to exactly what it was before.
{%- endcomment -%}

{%- style -%}
  .insta-collage-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    display: none;
  }

  .insta-collage-{{ section.id }}.insta-collage--ready {
    display: block;
  }

  /* Mobile first: centre text on top, then the four columns flowing
     into a two-column grid. Desktop lifts the centre back into the
     middle column of a five-column row. */
  .insta-collage__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    align-items: center;
  }

  .insta-collage__center {
    grid-column: 1 / -1;
    order: -1;
    text-align: center;
    margin-bottom: 1.6rem;
  }

  .insta-collage__col {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .insta-collage__slot {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }

  /* Feathered edges: a ring of the section's own background colour blurred
     inwards, so each photo melts into the page instead of ending on a hard
     line. Tune the first length (blur) for softness reach, the second
     (spread) for how far the fade eats into the image. */
  .insta-collage__slot::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    box-shadow: inset 0 0 2.4rem 0.6rem rgb(var(--color-background));
  }

  .insta-collage__slot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Wider than the site's page-width on purpose: the collage spreads
     toward the screen edges so the sides don't sit in dead whitespace,
     while the centre cell stays centred. */
  .insta-collage__wide {
    max-width: 148rem;
    margin: 0 auto;
    padding: 0 2.4rem;
  }

  /* Desktop: free composition, hand-placed on a 1480x640 stage (values
     from the layout editor session of 2026-08-21). Percentages scale
     with the container; each slot keeps its own aspect ratio. */
  @media screen and (min-width: 990px) {
    .insta-collage__grid {
      display: block;
      position: relative;
      aspect-ratio: 1480 / 640;
    }

    .insta-collage__center {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      order: 0;
      margin-bottom: 0;
      width: max-content;
    }

    /* Columns are only a mobile grouping device; on desktop they melt
       away so each slot positions against the stage itself. */
    .insta-collage__col {
      display: contents;
    }

    .insta-collage__slot {
      position: absolute;
    }

    .insta-collage__col--a .insta-collage__slot              { left: 1%;    top: 45.1%; width: 15.6%; aspect-ratio: 4 / 5; }
    .insta-collage__col--b .insta-collage__slot              { left: 19.8%; top: 5%;    width: 18.2%; aspect-ratio: 3 / 4; }
    .insta-collage__col--c .insta-collage__slot              { left: 61.4%; top: 29.8%; width: 18.2%; aspect-ratio: 4 / 5; }
    .insta-collage__col--d .insta-collage__slot:nth-child(1) { left: 82.7%; top: 5.8%;  width: 12.6%; aspect-ratio: 1 / 1; }
    .insta-collage__col--d .insta-collage__slot:nth-child(2) { left: 83%;   top: 52.2%; width: 15.6%; aspect-ratio: 4 / 5; }
  }

  .insta-collage__eyebrow {
    margin: 0 0 1.2rem;
  }

  /* Instagram glyph rides the eyebrow text at its own size. */
  .insta-collage__ig-icon {
    width: 1em;
    height: 1em;
    vertical-align: -0.15em;
    margin-left: 0.4em;
  }

  .insta-collage__marquee {
    display: none;
  }

  /* Mobile: the collage columns give way to one row of equal squares
     drifting left. */
  @media screen and (max-width: 989px) {
    .insta-collage__grid {
      display: block;
    }

    .insta-collage__center {
      margin-bottom: 2rem;
    }

    .insta-collage__col {
      display: none;
    }

    .insta-collage__wide {
      padding: 0;
    }

    .insta-collage__marquee {
      display: block;
      overflow: hidden;
    }

    .insta-collage__marquee-track {
      display: flex;
      width: max-content;
      animation: insta-marquee 30s linear infinite;
    }

    .insta-collage__marquee-track a {
      display: block;
      flex: none;
      width: 33vw;
      aspect-ratio: 1;
      margin-right: 0.8rem;
      overflow: hidden;
    }

    .insta-collage__marquee-track img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @keyframes insta-marquee {
      to {
        transform: translateX(-50%);
      }
    }
  }

  .insta-collage__handle {
    font-size: 2.4rem;
    letter-spacing: normal;
    line-height: 1.1;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }

  .insta-collage__handle:hover {
    text-decoration: underline;
    text-underline-offset: 0.4rem;
  }

  @media screen and (max-width: 989px) {
    .insta-collage__handle { font-size: 1.8rem; }
  }

  /* Applied to the Instafeed app's own section once the collage is
     filled. Kept as height-collapse rather than display:none so the
     app's scripts keep a live element to talk to. */
  .insta-collage-app-hidden {
    height: 0 !important;
    overflow: hidden !important;
    visibility: hidden !important;
    margin: 0 !important;
    padding: 0 !important;
  }
{%- endstyle -%}

<div id="InstaCollage-{{ section.id }}" class="insta-collage-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="insta-collage__wide">
    <div class="insta-collage__grid">
      <div class="insta-collage__center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="insta-collage__eyebrow caption-with-letter-spacing">
            {{- section.settings.eyebrow | escape -}}
            <svg class="insta-collage__ig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5.5"/>
              <circle cx="12" cy="12" r="4.5"/>
              <circle cx="17.2" cy="6.8" r="1.3" fill="currentColor" stroke="none"/>
            </svg>
          </p>
        {%- endif -%}
        <a class="insta-collage__handle" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener">
          {{- section.settings.handle | escape -}}
        </a>
      </div>

      {%- comment -%}
        Column layout: outer columns carry two images and ride high,
        inner columns carry one and sit low. The centre cell is placed
        between them by source order on desktop; on mobile it jumps to
        the top via order: -1.
      {%- endcomment -%}
      <div class="insta-collage__col insta-collage__col--a insta-collage__col--up">
        <a class="insta-collage__slot" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" data-collage-slot aria-label="{{ section.settings.handle | escape }} on Instagram"></a>
      </div>
      <div class="insta-collage__col insta-collage__col--b insta-collage__col--down">
        <a class="insta-collage__slot" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" data-collage-slot aria-label="{{ section.settings.handle | escape }} on Instagram"></a>
      </div>
      <div class="insta-collage__col insta-collage__col--c insta-collage__col--up">
        <a class="insta-collage__slot" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" data-collage-slot aria-label="{{ section.settings.handle | escape }} on Instagram"></a>
      </div>
      <div class="insta-collage__col insta-collage__col--d insta-collage__col--down">
        <a class="insta-collage__slot" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" data-collage-slot aria-label="{{ section.settings.handle | escape }} on Instagram"></a>
        <a class="insta-collage__slot" href="{{ section.settings.ig_url }}" target="_blank" rel="noopener" data-collage-slot aria-label="{{ section.settings.handle | escape }} on Instagram"></a>
      </div>
    </div>
  </div>
  {%- comment -%}
    Mobile replaces the collage columns with this marquee: one row of
    equal squares drifting left. The harvest fills the track with two
    copies of the image set, and translateX(-50%) loops seamlessly
    because both copies are identical in width.
  {%- endcomment -%}
  <div class="insta-collage__marquee">
    <div class="insta-collage__marquee-track" data-collage-track></div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('InstaCollage-{{ section.id }}');
    if (!root) return;
    var slots = root.querySelectorAll('[data-collage-slot]');
    var deadline = Date.now() + 10000;

    function harvest() {
      var items = document.querySelectorAll('#insta-feed [data-instafeed-thumbnail]');
      var urls = [];
      for (var i = 0; i < items.length; i++) {
        var u = items[i].getAttribute('data-instafeed-thumbnail');
        if (u && urls.indexOf(u) === -1) urls.push(u);
      }
      if (urls.length >= slots.length) {
        slots.forEach(function (slot, i) {
          var img = document.createElement('img');
          img.src = urls[i];
          img.alt = '';
          img.loading = 'lazy';
          slot.appendChild(img);
        });
        var track = root.querySelector('[data-collage-track]');
        if (track) {
          /* two identical copies -> translateX(-50%) loops without a seam */
          for (var copy = 0; copy < 2; copy++) {
            for (var j = 0; j < slots.length; j++) {
              var link = document.createElement('a');
              link.href = {{ section.settings.ig_url | json }};
              link.target = '_blank';
              link.rel = 'noopener';
              if (copy > 0) link.setAttribute('aria-hidden', 'true');
              if (copy > 0) link.tabIndex = -1;
              var mimg = document.createElement('img');
              mimg.src = urls[j];
              mimg.alt = '';
              mimg.loading = 'lazy';
              link.appendChild(mimg);
              track.appendChild(link);
            }
          }
        }
        root.classList.add('insta-collage--ready');
        var feed = document.querySelector('#insta-feed');
        var appSection = feed && feed.closest('.shopify-section');
        if (appSection) appSection.classList.add('insta-collage-app-hidden');
        return;
      }
      if (Date.now() < deadline) setTimeout(harvest, 400);
      /* deadline passed: leave the app's stock feed visible, collage stays hidden */
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', harvest);
    } else {
      harvest();
    }
  })();
</script>

{% schema %}
{
  "name": "Instagram collage",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Needs the Instafeed app block on the same page (it can sit below — it is hidden automatically once the collage loads)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Follow us"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle",
      "default": "@URBANSTUDIO.NAILS"
    },
    {
      "type": "url",
      "id": "ig_url",
      "label": "Instagram URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Instagram collage"
    }
  ]
}
{% endschema %}
