{%- comment -%}
  Editorial section modelled on wwake.com's homepage "editorial" block.

  Desktop is a three-column grid: a pair of small detail images on the
  left, text in the middle, one tall hero image on the right. The left
  pair is position: sticky, so while the taller hero column scrolls the
  small images follow the reader down the section — the effect only
  works because the sticky column is much shorter than the grid row it
  sits in. No JavaScript involved.

  On mobile the grid collapses to a single column: text first, then the
  hero, then the two detail shots side by side.
{%- endcomment -%}

{%- comment -%}
  No extra stylesheet needed: this theme keeps its .rte styles in
  base.css, which is loaded globally by theme.liquid.
{%- endcomment -%}
{%- style -%}
  .editorial-sticky-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .editorial-sticky__grid {
    display: grid;
    gap: 2.4rem;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    .editorial-sticky__grid {
      /* Small-pair column | text column | hero column. The fr values
         roughly mirror wwake's 408 / 320 / 464 px proportions. */
      grid-template-columns: 5fr 4fr 6fr;
      gap: 3.2rem;
    }
  }

  /* The sticky pair. top clears the sticky header; 9rem ≈ header height
     plus a small breathing gap. */
  .editorial-sticky__pair {
    display: flex;
    gap: 1.6rem;
    align-self: start;
  }

  @media screen and (min-width: 990px) {
    .editorial-sticky__pair {
      position: sticky;
      top: 9rem;
    }
  }

  .editorial-sticky__pair-item {
    flex: 1 1 0;
    margin: 0;
  }

  /* Keep the small images small: cap them well under half the column so
     the height difference against the hero column stays large — that
     difference is what makes the sticky effect visible at all. */
  @media screen and (min-width: 990px) {
    .editorial-sticky__pair-item {
      max-width: 14.4rem;
    }
  }

  .editorial-sticky__pair-item img,
  .editorial-sticky__hero img {
    display: block;
    width: 100%;
    height: auto;
  }

  .editorial-sticky__pair-item .placeholder-svg,
  .editorial-sticky__hero .placeholder-svg {
    width: 100%;
    height: 100%;
    background: rgba(var(--color-foreground), 0.04);
  }

  .editorial-sticky__pair-item .placeholder-svg {
    aspect-ratio: 4 / 5;
  }

  .editorial-sticky__hero {
    margin: 0;
  }

  .editorial-sticky__hero .placeholder-svg {
    aspect-ratio: 4 / 5;
  }

  /* Center the text block vertically against the hero column so the
     copy floats mid-section the way wwake's does. */
  .editorial-sticky__content {
    align-self: center;
  }

  .editorial-sticky__caption {
    margin: 0 0 1.2rem;
  }

  .editorial-sticky__heading {
    margin: 0 0 1.6rem;
  }

  .editorial-sticky__text {
    margin: 0 0 2rem;
  }

  .editorial-sticky__link {
    text-underline-offset: 0.3rem;
  }

  /* Mobile source order is handled with grid areas: content, hero,
     then the detail pair. */
  @media screen and (max-width: 989px) {
    .editorial-sticky__grid {
      grid-template-areas: 'content' 'hero' 'pair';
    }
    .editorial-sticky__pair { grid-area: pair; }
    .editorial-sticky__content { grid-area: content; }
    .editorial-sticky__hero-wrapper { grid-area: hero; }
  }
{%- endstyle -%}

<div class="editorial-sticky-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="editorial-sticky__grid">
      <div class="editorial-sticky__pair">
        {%- for i in (1..2) -%}
          {%- liquid
            assign image_setting = 'detail_image_' | append: i
            assign image = section.settings[image_setting]
          -%}
          <figure class="editorial-sticky__pair-item">
            {%- if image != blank -%}
              {{ image | image_url: width: 640 | image_tag: widths: '288, 432, 640', sizes: '(min-width: 990px) 144px, 45vw' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

      <div class="editorial-sticky__content">
        {%- if section.settings.caption != blank -%}
          <p class="editorial-sticky__caption caption-with-letter-spacing">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="editorial-sticky__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="editorial-sticky__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="editorial-sticky__link link underlined-link">
            {{- section.settings.link_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="editorial-sticky__hero-wrapper">
        <figure class="editorial-sticky__hero">
          {%- if section.settings.hero_image != blank -%}
            {{ section.settings.hero_image | image_url: width: 1500 | image_tag: widths: '465, 750, 1100, 1500', sizes: '(min-width: 990px) 465px, 100vw' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </figure>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial sticky",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "detail_image_1",
      "label": "Detail image 1 (sticky pair)"
    },
    {
      "type": "image_picker",
      "id": "detail_image_2",
      "label": "Detail image 2 (sticky pair)"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Tall hero image"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "default": "003"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Checked twice, shipped once"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Editorial sticky"
    }
  ]
}
{% endschema %}
