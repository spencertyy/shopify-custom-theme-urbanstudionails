{%- comment -%}
  Values carousel modelled on palmer-dinnerware.com's about-page block:
  a list of short titles on the left, one image in the middle, the full
  heading + text for the active entry on the right.

  Auto-advances every N seconds (setting). Clicking a title switches
  immediately and pauses the rotation for a while so the reader isn't
  interrupted mid-read. Autoplay only runs while the section is on
  screen, and never starts for prefers-reduced-motion users.

  On mobile the grid collapses: titles become a horizontal row above
  the image, detail text below.
{%- endcomment -%}

{%- style -%}
  .values-carousel-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .values-carousel__grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 46rem) 1fr;
    column-gap: 6.4rem;
    align-items: center;
  }

  .values-carousel__titles {
    display: flex;
    flex-direction: column;
    gap: 3.4rem;
  }

  .values-carousel__title-btn {
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 0;
    font-family: inherit;
    font-weight: 300;
    font-size: 3.4rem;
    line-height: 1.15;
    color: #c9c7c2;
    transition: color 0.45s ease;
  }

  .values-carousel__title-btn:hover {
    color: #8a8880;
  }

  .values-carousel__title-btn.is-active {
    color: #2f2f2f;
  }

  .values-carousel__stage {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin: 0;
  }

  .values-carousel__stage img,
  .values-carousel__stage .placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .values-carousel__stage img.is-active,
  .values-carousel__stage .placeholder-svg.is-active {
    opacity: 1;
  }

  .values-carousel__detail {
    position: relative;
  }

  .values-carousel__item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .values-carousel__item.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .values-carousel__item-caption {
    margin: 0 0 1.4rem;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    color: #8a8880;
  }

  .values-carousel__item-heading {
    font-weight: 300;
    font-size: 2.4rem;
    line-height: 1.3;
    color: #2f2f2f;
    margin: 0 0 1.6rem;
  }

  .values-carousel__item-text {
    margin: 0;
    max-width: 26em;
    font-size: 1.45rem;
    line-height: 1.8;
    color: #424242;
  }

  .values-carousel__progress {
    height: 1px;
    width: 20rem;
    margin-top: 2.6rem;
    background: #e5e3de;
    position: relative;
    overflow: hidden;
  }

  .values-carousel__progress i {
    position: absolute;
    inset: 0;
    background: #424242;
    transform-origin: left;
    transform: scaleX(0);
  }

  .values-carousel__progress i.is-running {
    animation: values-carousel-fill {{ section.settings.autoplay_interval }}s linear forwards;
  }

  @keyframes values-carousel-fill {
    to { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .values-carousel__progress { display: none; }
  }

  @media screen and (max-width: 989px) {
    .values-carousel__grid {
      display: block;
    }

    .values-carousel__titles {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .values-carousel__title-btn {
      font-size: 1.9rem;
    }

    .values-carousel__stage {
      margin-bottom: 3rem;
    }

    .values-carousel__detail {
      min-height: 21rem;
    }
  }
{%- endstyle -%}

<div class="values-carousel-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="values-carousel__grid" id="ValuesCarousel-{{ section.id }}" data-interval="{{ section.settings.autoplay_interval | times: 1000 }}">

      <div class="values-carousel__titles">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="values-carousel__title-btn{% if forloop.first %} is-active{% endif %}"
            data-index="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.short_title | escape }}</button>
        {%- endfor -%}
      </div>

      <figure class="values-carousel__stage">
        {%- for block in section.blocks -%}
          {%- liquid
            assign img_class = ''
            if forloop.first
              assign img_class = 'is-active'
            endif
          -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 1100
              | image_tag:
                widths: '460, 690, 920, 1100',
                sizes: '(min-width: 990px) 460px, 100vw',
                class: img_class,
                loading: 'lazy'
            }}
          {%- else -%}
            {%- assign ph_class = 'placeholder-svg ' | append: img_class -%}
            {{ 'image' | placeholder_svg_tag: ph_class }}
          {%- endif -%}
        {%- endfor -%}
      </figure>

      <div class="values-carousel__detail">
        {%- for block in section.blocks -%}
          <div class="values-carousel__item{% if forloop.first %} is-active{% endif %}">
            {%- if block.settings.caption != blank -%}
              <p class="values-carousel__item-caption caption-with-letter-spacing">{{ block.settings.caption | escape }}</p>
            {%- endif -%}
            <h3 class="values-carousel__item-heading">{{ block.settings.heading | escape }}</h3>
            <div class="values-carousel__item-text rte">{{ block.settings.text }}</div>
            <div class="values-carousel__progress"><i{% if forloop.first %} class="is-running"{% endif %}></i></div>
          </div>
        {%- endfor -%}
      </div>

    </div>
  </div>
</div>

<script>
  (() => {
    const root = document.getElementById('ValuesCarousel-{{ section.id }}');
    if (!root) return;
    const btns = [...root.querySelectorAll('.values-carousel__title-btn')];
    const imgs = [...root.querySelectorAll('.values-carousel__stage > img, .values-carousel__stage > svg')];
    const items = [...root.querySelectorAll('.values-carousel__item')];
    if (btns.length < 2) return;

    const INTERVAL = parseInt(root.dataset.interval, 10) || 5000;
    const PAUSE_AFTER_CLICK = 12000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cur = 0;
    let timer = null;
    let resumeTimer = null;
    let visible = false;

    function show(i) {
      cur = i;
      btns.forEach((b, k) => b.classList.toggle('is-active', k === i));
      imgs.forEach((m, k) => m.classList.toggle('is-active', k === i));
      items.forEach((d, k) => {
        d.classList.toggle('is-active', k === i);
        const bar = d.querySelector('.values-carousel__progress i');
        bar.classList.remove('is-running');
        void bar.offsetWidth; /* restart the fill animation from zero */
        if (k === i && !reduced) bar.classList.add('is-running');
      });
    }

    function start() {
      if (reduced || timer) return;
      timer = setInterval(() => show((cur + 1) % btns.length), INTERVAL);
    }

    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }

    btns.forEach((b, i) => b.addEventListener('click', () => {
      show(i);
      stop();
      clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => { if (visible) start(); }, PAUSE_AFTER_CLICK);
    }));

    /* Autoplay only while the section is actually on screen. */
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      if (visible) start(); else stop();
    }, { threshold: 0.3 }).observe(root);

    show(0);
  })();
</script>

{% schema %}
{
  "name": "Values carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay interval",
      "default": 5
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Entry",
      "settings": [
        {
          "type": "text",
          "id": "short_title",
          "label": "Short title (left list)",
          "default": "Original"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "001"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Full heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values carousel",
      "blocks": [
        { "type": "entry" },
        { "type": "entry" },
        { "type": "entry" }
      ]
    }
  ]
}
{% endschema %}
