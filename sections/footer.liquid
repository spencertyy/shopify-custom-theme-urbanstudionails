{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<link rel="stylesheet" href="{{ 'section-footer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-payment.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-list-social.css' | asset_url }}" media="print" onload="this.media='all'">

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* ── Footer redesign ── */
  .section-{{ section.id }}-padding {
    border-top: none;
  }

  @media screen and (min-width: 990px) {
    /* Dawn caps the footer at --page-width and centres it, which on a wide
       screen leaves a large empty margin on both sides while the three columns
       sit marooned in the middle. Run it edge to edge with a fixed inset
       instead, so the content sits close to the viewport edge at any width. */
    .section-{{ section.id }}-padding .footer__content-top.page-width,
    .section-{{ section.id }}-padding .footer__content-bottom-wrapper.page-width {
      max-width: 100%;
      padding-left: 4rem;
      padding-right: 4rem;
    }
    /* Three tracks: the menu sizes to its links on the left, the newsletter
       sizes to itself on the right, and the brand block takes whatever is left
       in the middle — so the wordmark stays centred in the row no matter how
       wide the screen gets. */
    /* 1fr auto 1fr, not auto 1fr auto: equal side tracks put the middle track
       dead centre in the row regardless of how much wider the newsletter is
       than the menu, so the wordmark lands on the true centre line. Each side
       block then anchors to its own outer edge. */
    .section-{{ section.id }}-padding .footer__content-top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: start;
      gap: 0 4rem;
      /* ① 内容与虚线之间的空白，第一段（另一段见 .footer__content-bottom
         的 padding-top）。两段相加就是虚线上方的总间距。 */
      padding-bottom: 1.6rem;
    }
    /* grid-row is stated as well as grid-column: this block comes after the
       newsletter in the markup, and grid's default sparse placement never goes
       back to fill an earlier row, so column 2 alone would drop it to row 2. */
    .section-{{ section.id }}-padding .footer__brand-block-{{ section.id }} {
      grid-column: 2 / 3;
      grid-row: 1;
      justify-self: center;
      /* The row is align-items: start, which lines the three columns up by
         their top edges. A wordmark has no baseline to share with a heading, so
         it reads better centred against the taller columns either side. */
      align-self: center;
    }
    /* Flex rather than two auto grid tracks: with the Policy column disabled
       only one block is left, and a fixed second track kept reserving space
       beside it. */
    .section-{{ section.id }}-padding .footer__blocks-wrapper {
      grid-column: 1 / 2;
      grid-row: 1;
      display: flex;
      justify-content: flex-start;
      gap: 0 8rem;
      margin-bottom: 0;
    }
    /* Dawn's .grid is a flex layout that divides space by giving each
       .grid__item a percentage width — grid--4-col-desktop sets 25%. Once the
       wrapper above becomes a real CSS grid, that percentage resolves against
       the track instead of the row, leaving each column of links at a quarter
       of its track (~79px) and wrapping "Brand Story" onto two lines. Let the
       tracks do the sizing. */
    .section-{{ section.id }}-padding .footer__blocks-wrapper > .grid__item {
      width: auto;
      max-width: none;
      padding-left: 0;
    }
    .section-{{ section.id }}-padding .footer-block--newsletter {
      /* Third track, held to the right edge. */
      grid-column: 3 / 4;
      grid-row: 1;
      justify-self: end;
      margin-top: 0;
      align-items: flex-start;
      justify-content: flex-start;
    }
    /* Second row spanning all three tracks: the icons clear the wordmark and
       land centred just above the rule. Living on its own row rather than
       inside the brand block is what lets the gap above it grow without
       pushing the wordmark up. */
    .section-{{ section.id }}-padding .footer__social-below-wordmark-{{ section.id }} {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: center;
      margin-top: 3.2rem;
    }
    .section-{{ section.id }}-padding .footer-block__newsletter {
      text-align: left;
      /* was 28rem — a one-line heading fitted, but the subtext under it wrapped
         into a narrow four-line column. */
      max-width: 34rem;
    }
    .section-{{ section.id }}-padding .newsletter-form__field-wrapper {
      max-width: 100%;
    }
  }

  /* ── Below the three-column breakpoint ──
     Stacked, the source order puts the wordmark between the newsletter and the
     social icons, where it reads as a stray graphic rather than as the brand.
     Lifting it to the top gives the stack something to open on, and pairs it
     with the social icons that already sit directly beneath it. */
  @media screen and (max-width: 989px) {
    .section-{{ section.id }}-padding .footer__content-top {
      display: flex;
      flex-direction: column;
      gap: 3.2rem;
    }
    /* Wordmark first, social icons straight after it — they are siblings now,
       so both need an order to stay together at the top of the stack. */
    .section-{{ section.id }}-padding .footer__brand-block-{{ section.id }} {
      order: -2;
    }
    .section-{{ section.id }}-padding .footer__social-below-wordmark-{{ section.id }} {
      order: -1;
    }
    .section-{{ section.id }}-padding .footer__blocks-wrapper,
    .section-{{ section.id }}-padding .footer-block--newsletter {
      margin: 0;
    }
    /* Left as one centred column: a footer read on a phone is scanned down the
       middle, and centring the wordmark but ranging the links left leaves the
       stack looking unresolved. */
    /* The heading is named as well as its container — Dawn ranges
       .footer-block__heading left with a rule of its own, which an inherited
       text-align on the parent cannot override. */
    .section-{{ section.id }}-padding .footer-block__newsletter,
    .section-{{ section.id }}-padding .footer-block--menu,
    .section-{{ section.id }}-padding .footer-block--menu .footer-block__heading,
    .section-{{ section.id }}-padding .footer-block__newsletter .footer-block__heading {
      text-align: center;
    }
    /* Four short links stacked cost 180px of scrolling on a phone for very
       little. On one wrapping row they take 45px and the stack stays short.
       The 45px touch height moves into the row, so each link keeps its tap
       target — it is the height that matters for a fingertip, and the gap
       between links covers the width. */
    .section-{{ section.id }}-padding .footer-block__details-content {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0 2.8rem;
    }
    .section-{{ section.id }}-padding .footer__newsletter .field {
      max-width: 32rem;
      margin: 0 auto;
    }
    .section-{{ section.id }}-padding .footer__copyright,
    .section-{{ section.id }}-padding .footer__copyright .policies {
      justify-content: center;
      text-align: center;
    }
  }

  .section-{{ section.id }}-padding .footer-block__heading {
    font-size: 1.4rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  /* The heading is back to the shared tracked-caps label the other footer
     columns use ("PRODUCT", "POLICY") — it names the block rather than
     selling it, and the sentence below carries the message. That inversion,
     small label over larger line, is what makes this read as restrained. */
  .section-{{ section.id }}-padding .footer-block__newsletter-text {
    margin: 1.2rem 0 2rem;
  }
  /* Matches the footer link columns exactly — 1.4rem, same line height, same
     opacity. The sentence sits level with the menu items beside it instead of
     reading as a different size of type in the same row. */
  .section-{{ section.id }}-padding .footer-block__newsletter-text p {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.8;
    color: rgba(var(--color-foreground), 0.75);
  }

  .section-{{ section.id }}-padding .footer__newsletter .field {
    border-radius: 0;
    border: none;
    /* Width stays fixed at 2px in both states and only the colour changes, so
       focusing the input cannot nudge the layout by half a pixel. */
    border-bottom: 2px solid rgba(var(--color-foreground), 0.45);
    background: transparent;
    box-shadow: none;
  }
  /* Dawn draws the input's box with a spread box-shadow on ::after, not with
     border — so clearing border/box-shadow on .field above leaves the frame
     untouched. These two kill it and leave only the rule underneath. */
  .section-{{ section.id }}-padding .footer__newsletter .field::before,
  .section-{{ section.id }}-padding .footer__newsletter .field::after {
    box-shadow: none;
    border: none;
  }
  /* Removing the frame also removed the focus ring, so the remaining rule
     carries it: the underline goes from muted to full strength on focus.
     Done with border-colour rather than box-shadow because Dawn already
     drives box-shadow on .field and its pseudo-elements from several rules
     and a transition, and this needs to be the one thing deciding it. */
  .section-{{ section.id }}-padding .footer__newsletter .field:focus-within {
    border-bottom-color: rgba(var(--color-foreground), 1);
  }
  .section-{{ section.id }}-padding .footer__newsletter .field__input {
    background: transparent;
    border: none;
    padding-left: 0;
    font-size: 0.8rem;
  }
  .section-{{ section.id }}-padding .footer__newsletter .field__label {
    padding-left: 0;
  }
  /* Dawn's own arrow, back in place of the "OK" label. */
  .section-{{ section.id }}-padding .newsletter-form__button {
    color: rgb(var(--color-foreground));
    transition: transform var(--duration-short) ease;
  }
  .section-{{ section.id }}-padding .newsletter-form__button svg {
    width: 2rem;
    height: 2rem;
  }
  .section-{{ section.id }}-padding .newsletter-form__button:hover svg {
    transform: translateX(0.3rem);
  }

  /* Pink footer background */
  .section-{{ section.id }}-padding,
  .section-{{ section.id }}-padding .footer__content-bottom {
    background: {{ section.settings.footer_bg_color }};
    border-top: none;
  }

  /* Dawn styles this row as fine print via .caption. Once it carries the real
     navigation — sizing, FAQ, contact — it is not fine print any more, so it
     takes the same tracked caps as the column headings above it and enough
     size to be read rather than skimmed past. */
  .section-{{ section.id }}-padding .footer__copyright .copyright__content,
  .section-{{ section.id }}-padding .footer__copyright .policies a,
  .section-{{ section.id }}-padding .footer__localization .caption-large {
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* The copyright is an inline <small> and the link list is a block-level flex
     that fills the row, so by default they can only stack. Making the wrapper
     a flex row puts the year and the links on one line, the way the reference
     footers read. */
  .section-{{ section.id }}-padding .footer__copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem 2rem;
  }
  .section-{{ section.id }}-padding .footer__copyright .policies {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 2rem;
  }
  .section-{{ section.id }}-padding .footer__copyright .policies li {
    flex: 0 0 auto;
    margin: 0;
  }
  /* Dawn separates these links with a "·" drawn as a 20px ::before. It does not
     show up in textContent, so it reads purely as extra space — the gap looked
     twice what was set. The reference footers separate on whitespace alone. */
  .section-{{ section.id }}-padding .footer__copyright .policies li::before {
    display: none;
  }
  /* Payment icons stay first in the markup but read last: the copyright row is
     the one people scan for policy links, so it comes directly under the
     content above it and the icons close the footer. Reordering in CSS rather
     than moving the markup keeps the source order Dawn expects. */
  .section-{{ section.id }}-padding .footer__content-bottom {
    display: flex;
    flex-direction: column;
    /* 1.6rem left the icons overhanging the footer's bottom edge by 4px —
       the icon row is taller than its text-sized line box. */
    padding-bottom: 1rem;
  }
  /* With payment icons off this wrapper renders empty — the Liquid condition is
     on its contents, not on the wrapper — and would still draw the rule and
     spacing around nothing. */
  .section-{{ section.id }}-padding
    .footer__content-bottom
    > .footer__content-bottom-wrapper:first-of-type:not(:has(.footer__payment)) {
    display: none;
  }
  .section-{{ section.id }}-padding .footer__content-bottom > .footer__content-bottom-wrapper:first-of-type {
    order: 2;
    margin-top: 2.4rem;
    padding-top: 1rem;
  }
  .section-{{ section.id }}-padding .footer__content-bottom > .footer__content-bottom-wrapper:last-of-type {
    order: 1;
  }

  /* Copyright and links on the left, currency on the right, one line. */
  /* Centred now that the currency selector has been turned off and the
     copyright line is the only thing on this row — space-between would just
     pin it to the left edge.

     The dashed rule lives here rather than on the payment wrapper: it marks
     the boundary between the brand content above and the legal line below,
     which holds whether or not payment icons are shown. */
  .section-{{ section.id }}-padding .footer__content-bottom > .footer__content-bottom-wrapper:last-of-type {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 1.2rem 3rem;
    /* The space above the rule was 74px, stacked from three sources: this
       margin, the top row's padding-bottom and .footer__content-bottom's own
       padding-top. Trimmed at each source rather than only here, since
       removing 74px from one of them would have needed a negative value. */
    margin-top: 0;
    padding-top: 1.8rem;
    border-top: 1px dashed rgba(var(--color-foreground), 0.35);
  }
  .section-{{ section.id }}-padding .footer__content-bottom {
    /* ② 内容与虚线之间的空白，第二段。想让虚线离内容更近就减小这个数字，
       想留更多空气就调大；与上面 ① 的 padding-bottom 相加即总间距。 */
    padding-top: 2rem;
  }
  .section-{{ section.id }}-padding .footer__copyright {
    justify-content: center;
  }
  /* The wrapper div renders whether or not the selectors inside it do — the
     Liquid conditions are on its contents, not on the div. Left in place it
     still contributes a flex gap and pulls the centred copyright off centre. */
  .section-{{ section.id }}-padding
    .footer__content-bottom-wrapper
    .footer__localization:not(:has(localization-form)) {
    display: none;
  }
  /* .footer__column carries width: 100%, which flex: 0 0 auto cannot override —
     a stated width wins over an auto basis. Without clearing it the block fills
     the row and pushes itself onto a second line. */
  .section-{{ section.id }}-padding .footer__content-bottom-wrapper .footer__localization {
    display: flex;
    flex: 0 0 auto;
    width: auto;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.2rem;
    margin: 0;
    padding: 0;
  }
  /* "Country/region" is a block-level heading by default, which would push the
     selector onto a second line inside a row that is meant to be one line. */
  .section-{{ section.id }}-padding .footer__localization .caption-large {
    margin: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .section-{{ section.id }}-padding .footer__localization localization-form {
    margin: 0;
  }
  /* The label and the selector are wrapped in a plain <div> inside the <form>,
     not directly under <localization-form> — targeting the custom element's
     children misses it and leaves the label stacked above the control. */
  .section-{{ section.id }}-padding .footer__localization .localization-form,
  .section-{{ section.id }}-padding .footer__localization .localization-form > div {
    display: flex;
    align-items: center;
    gap: 0 1.2rem;
    margin: 0;
  }

  /* The selector is a white filled box by default. Stripped back to the same
     treatment as the email field: transparent, no frame, one rule underneath. */
  .section-{{ section.id }}-padding .footer__localization .localization-form__select,
  .section-{{ section.id }}-padding .footer__localization .disclosure__button {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.45);
    border-radius: 0;
    box-shadow: none;
    padding: 0.4rem 0;
    min-height: 0;
    font-size: 1rem;
    transition: border-bottom-color var(--duration-short) ease;
  }
  .section-{{ section.id }}-padding .footer__localization .localization-form__select:hover,
  .section-{{ section.id }}-padding .footer__localization .disclosure__button:hover,
  .section-{{ section.id }}-padding .footer__localization .disclosure__button[aria-expanded='true'] {
    border-bottom-color: rgba(var(--color-foreground), 1);
  }

  /* The footer menu inherits the main nav, whose items are laid out inline for
     the header. In a footer column they need to stack. */
  .section-{{ section.id }}-padding .footer-block__details-content > li {
    display: block;
  }
  /* Stated here rather than inherited from Dawn so the menu links have a size
     of their own to adjust, alongside every other size in this file. */
  .section-{{ section.id }}-padding .footer-block__details-content a {
    font-size: 1.4rem;
  }

  /* This column is flex-direction: column, where align-items — not
     justify-content — is the horizontal axis. Dawn sets align-items: flex-end,
     which is what holds the icons to the right; setting justify-content here
     only moves them vertically and appears to do nothing. */
  .section-{{ section.id }}-padding .footer__column--info {
    align-items: flex-start;
  }
  .section-{{ section.id }}-padding .footer__payment {
    display: flex;
    justify-content: flex-start;
    margin: 0;
  }
  .section-{{ section.id }}-padding .footer__payment .list-payment {
    justify-content: flex-start;
    margin: 0;
    padding: 0;
  }

  /* The wordmark used to span the full page width on a row of its own. As the
     middle column of the top row it is capped and centred instead — the SVG
     scales to whatever width it is given, so the cap is all it takes. */
  .footer__brand-block-{{ section.id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  .footer__brand-wordmark-{{ section.id }} {
    width: 100%;
    max-width: {{ section.settings.brand_logo_width | default: 30 }}rem;
    padding: 0;
    margin: 0;
    overflow: hidden;
  }

  .footer__brand-wordmark-{{ section.id }} svg,
  .footer__brand-wordmark-{{ section.id }} .footer__brand-logo-img {
    display: block;
    width: 100%;
    height: auto;
    color: rgb(var(--color-foreground));
  }

  .footer__social-below-wordmark-{{ section.id }} {
    padding: 0.8rem 0 0;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }

  .footer__social-below-wordmark-{{ section.id }} .footer__follow-on-shop,
  .footer__social-below-wordmark-{{ section.id }} .footer__follow-on-shop:first-child:not(:last-child) {
    display: flex;
    align-items: center;
    margin-right: 0;
    justify-content: center;
    text-align: center;
  }

  .footer__social-below-wordmark-{{ section.id }} .footer__list-social {
    margin: 0;
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.newsletter_enable == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.newsletter_enable
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper grid grid--1-col grid--2-col grid--4-col-tablet {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <ul class="footer-block__details-content list-unstyled">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a
                              href="{{ link.url }}"
                              class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                            >
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- if settings.brand_image != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: settings.brand_image.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}
                      {%- if settings.brand_headline != blank -%}
                        <h2 class="footer-block__heading rte">{{ settings.brand_headline }}</h2>
                      {%- endif -%}
                      {%- if settings.brand_description != blank -%}
                        <div class="rte">{{ settings.brand_description }}</div>
                      {%- endif -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div
          class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if section.settings.newsletter_enable -%}
            <div class="footer-block__newsletter">
              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="footer-block__heading inline-richtext">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}
              {%- if section.settings.newsletter_subtext != blank -%}
                <div class="footer-block__newsletter-text rte">{{ section.settings.newsletter_subtext }}</div>
              {%- endif -%}
              {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="newsletter-form__field-wrapper">
                  <div class="field">
                    <input
                      id="NewsletterForm--{{ section.id }}"
                      type="email"
                      name="contact[email]"
                      class="field__input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="ContactFooter-error"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="ContactFooter-success"
                      {% endif %}
                      placeholder="{{ 'newsletter.label' | t }}"
                      required
                    >
                    <label class="field__label" for="NewsletterForm--{{ section.id }}">
                      {{ 'newsletter.label' | t }}
                    </label>
                    <button
                      type="submit"
                      class="newsletter-form__button field__button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      {% render 'icon-arrow' %}
                    </button>
                  </div>
                  {%- if form.errors -%}
                    <small class="newsletter-form__message form__message" id="ContactFooter-error">
                      {%- render 'icon-error' -%}
                      {{- form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email -}}
                    </small>
                  {%- endif -%}
                </div>
                {%- if form.posted_successfully? -%}
                  <h3
                    class="newsletter-form__message newsletter-form__message--success form__message"
                    id="ContactFooter-success"
                    tabindex="-1"
                    autofocus
                  >
                    {% render 'icon-success' -%}
                    {{- 'newsletter.success' | t }}
                  </h3>
                {%- endif -%}
              {%- endform -%}
            </div>
          {%- endif -%}

        </div>

        {%- comment -%}
          Brand block: the wordmark with the social icons directly beneath it,
          sitting between the menu column and the newsletter.
        {%- endcomment -%}
        <div class="footer__brand-block-{{ section.id }}">
          {%- comment -%}
            An uploaded logo wins over the text rendering. A logo set in a
            licensed typeface can be used here as an image without needing the
            web licence embedding the font itself would require, and it keeps
            the exact spacing and any tagline that a web font could not
            reproduce. The SVG stays as the fallback so the footer is never
            left without a brand mark.
          {%- endcomment -%}
          <div class="footer__brand-wordmark-{{ section.id }}" aria-label="{{ shop.name }}">
            {%- if section.settings.brand_logo != blank -%}
              {{
                section.settings.brand_logo
                | image_url: width: 1200
                | image_tag: loading: 'lazy', alt: shop.name, class: 'footer__brand-logo-img'
              }}
            {%- else -%}
              <svg viewBox="0 0 1200 150" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
                <text x="600" y="130" text-anchor="middle" font-size="170" fill="currentColor"
                  textLength="1180" lengthAdjust="spacingAndGlyphs"
                  style="font-weight:900;letter-spacing:-2px;font-family:inherit">{{ shop.name }}</text>
              </svg>
            {%- endif -%}
          </div>
        </div>
        {%- comment -%}
          A sibling of the brand block rather than a child of it, so the top row
          can place it on a second line of its own — centred above the dashed
          rule on desktop, directly under the wordmark on phones.
        {%- endcomment -%}
        <div class="footer__social-below-wordmark-{{ section.id }}">
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="footer__follow-on-shop">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'footer__list-social' -%}
          {%- endif -%}
        </div>
      </div>
    {%- endunless -%}
  {%- endif -%}

  {%- comment -%}
    The wordmark and social icons used to sit here, on two rows of their own
    between the menus and the bottom bar. They now render inside
    .footer__content-top as its middle column.
  {%- endcomment -%}

  <div
    class="footer__content-bottom{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {%- comment -%}
      The country and language selectors used to sit here, above the copyright.
      They now render inside the copyright row further down so the year, the
      policy links and the currency read as one line. This wrapper is left
      carrying only the payment icons, and CSS reorders it below that row.
    {%- endcomment -%}
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %}">
      <div class="footer__copyright caption">
        {%- comment -%}
          Brand name first, then the year, with no comma between — the year is
          still generated from the current date, so it rolls over on its own.
        {%- endcomment -%}
        <small class="copyright__content"
          >&copy; {{ shop.name | link_to: routes.root_url }} {{ 'now' | date: '%Y' -}}
        </small>
        {%- comment -%}
          shop.policies only ever yields the policy pages configured in the
          Shopify admin, under titles Shopify fixes ("Refund policy", "Terms of
          service"). A linklist can hold anything and be worded freely, so it
          takes precedence when one is chosen; the policy loop stays as the
          fallback so nothing disappears if the menu is later unset.
        {%- endcomment -%}
        {%- if section.settings.bottom_menu != blank -%}
          <ul class="policies list-unstyled">
            {%- for link in section.settings.bottom_menu.links -%}
              <li>
                <small class="copyright__content"><a href="{{ link.url }}">{{ link.title | escape }}</a></small>
              </li>
            {%- endfor -%}
          </ul>
        {%- elsif section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="copyright__content"
                    ><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      {%- comment -%}
        Moved up from the wrapper above so the currency sits at the end of the
        copyright line rather than on a row of its own.
      {%- endcomment -%}
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}

        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.brand_information.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Image width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Image alignment on large screen",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "footer_bg_color",
      "label": "Footer background color",
      "default": "#f5b1d5"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Footer logo image",
      "info": "Shown in the middle of the footer. Upload a transparent PNG or an SVG. Leave empty to render the shop name as text instead."
    },
    {
      "type": "range",
      "id": "brand_logo_width",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "rem",
      "label": "Footer logo width",
      "default": 30
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "richtext",
      "id": "newsletter_subtext",
      "label": "Newsletter text",
      "info": "One line under the heading saying what subscribers actually get. Leave blank to hide."
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content",
      "info": "t:sections.footer.settings.header__9.info"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__2.content",
      "info": "t:sections.footer.settings.header__2.info"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__3.content",
      "info": "t:sections.footer.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__5.content",
      "info": "t:sections.footer.settings.header__6.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_language_selector.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__7.content"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "t:sections.footer.settings.payment_enable.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__8.content",
      "info": "t:sections.footer.settings.header__8.info"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "t:sections.footer.settings.show_policy.label"
    },
    {
      "type": "link_list",
      "id": "bottom_menu",
      "label": "Bottom row menu",
      "info": "Replaces the policy links on the bottom row, so the wording and order are yours. Leave empty to keep Shopify's policy links."
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "text"
      }
    ]
  }
}
{% endschema %}
