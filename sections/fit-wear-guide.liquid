{%- comment -%}
  Fit & Wear Guide — the page behind "Fit & Wear Guide" in the footer.
  Collapsible panels (native <details>, no JS).

  Block order drives the layout:
    panel  — starts a new collapsible panel; every block after it belongs to
             it until the next panel
    steps  — the illustrated apply or remove steps. The steps themselves live
             in snippets/fit-guide-steps.liquid, shared with the product page
             accordion, so copy and drawings are edited there, once.
    note   — a line of rich text
    image  — a full-width image (the size chart)
{%- endcomment -%}

{% style %}
  .fwg-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .fwg-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  .fwg-{{ section.id }} .fwg__inner { max-width: 110rem; margin: 0 auto; }
  .fwg-{{ section.id }} .fwg__panel { border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.12); }
  .fwg-{{ section.id }} .fwg__panel:first-of-type { border-top: 0.1rem solid rgba(var(--color-foreground), 0.12); }
  .fwg-{{ section.id }} .fwg__panel > summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.6rem;
    padding: 2.2rem 0;
    font-size: 1.8rem;
    font-weight: var(--font-body-weight);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .fwg-{{ section.id }} .fwg__panel > summary::-webkit-details-marker { display: none; }
  .fwg-{{ section.id }} .fwg__icon { flex-shrink: 0; width: 1.4rem; height: 1.4rem; transition: transform 0.2s ease; }
  .fwg-{{ section.id }} .fwg__panel[open] .fwg__icon { transform: rotate(45deg); }
  .fwg-{{ section.id }} .fwg__body { padding: 0.8rem 0 4rem; }
  .fwg-{{ section.id }} .fwg__note { margin: 4rem 0 0; font-size: 1.8rem; }
  .fwg-{{ section.id }} .fwg__note > * { margin: 0; }
  @media screen and (min-width: 750px) {
    .fwg-{{ section.id }} .fwg__note { font-size: 2rem; }
  }
  .fwg-{{ section.id }} .fwg__image { margin: 1.6rem auto 0; }
  .fwg-{{ section.id }} .fwg__image img { display: block; width: 100%; height: auto; }
{% endstyle %}

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign in_panel = false
-%}

<div class="fwg-{{ section.id }}">
  <div class="page-width">
    <div class="fwg__inner">
      <h1 class="main-page-title page-title h0">{{ heading | escape }}</h1>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'panel' -%}
            {%- if in_panel -%}</div></details>{%- endif -%}
            <details class="fwg__panel"{% if block.settings.open %} open{% endif %} {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.title | escape }}</span>
                <svg class="fwg__icon" viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                  <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </summary>
              <div class="fwg__body">
            {%- assign in_panel = true -%}

          {%- when 'steps' -%}
            <div {{ block.shopify_attributes }}>
              {%- render 'fit-guide-steps', part: block.settings.part -%}
            </div>

          {%- when 'note' -%}
            <div class="fwg__note rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'image' -%}
            {%- if block.settings.image != blank -%}
              <div class="fwg__image" style="max-width: {{ block.settings.max_width }}px;" {{ block.shopify_attributes }}>
                {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: block.settings.alt, widths: '600, 900, 1200, 1600' }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- if in_panel -%}</div></details>{%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fit & wear guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty to use the page title.",
      "default": "Fit & Wear Guide"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Collapsible panel",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "How to apply" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ]
    },
    {
      "type": "steps",
      "name": "Illustrated steps",
      "settings": [
        {
          "type": "select",
          "id": "part",
          "label": "Steps",
          "options": [
            { "value": "apply", "label": "How to apply" },
            { "value": "remove", "label": "How to remove" }
          ],
          "default": "apply",
          "info": "Copy and drawings are edited in snippets/fit-guide-steps.liquid."
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Give it an hour before water.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        {
          "type": "range",
          "id": "max_width",
          "label": "Max width",
          "min": 400,
          "max": 1200,
          "step": 50,
          "unit": "px",
          "default": 800
        }
      ]
    }
  ],
  "presets": [{ "name": "Fit & wear guide" }]
}
{% endschema %}
